# --- Veritabanı (Neon PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/otohesap?sslmode=require
# Asistan yalnız bu salt-okur bağlantıyı kullanır
DATABASE_URL_RO=postgresql://otohesap_ro:PASSWORD@HOST/otohesap?sslmode=require

# --- LLM (tek adaptör: apps/api/app/services/llm.py) ---
LLM_PROVIDER=anthropic            # anthropic | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Kalite modu (zor sorular / eval kaçırırsa): claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tedarik ajanı ---
AGENT_CHECK_INTERVAL_MIN=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
