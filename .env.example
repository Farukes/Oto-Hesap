# --- Veritabanı (Neon PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/otohesap?sslmode=require
# Asistan yalnız bu salt-okur bağlantıyı kullanır
DATABASE_URL_RO=postgresql://otohesap_ro:PASSWORD@HOST/otohesap?sslmode=require

# --- LLM (tek adaptör: apps/api/app/services/llm.py) ---
LLM_PROVIDER=anthropic            # anthropic | gemini | groq | ollama (yerel Qwen: ollama pull qwen2.5:7b)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Kalite modu (zor sorular / eval kaçırırsa): claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # konsoldan güncel adı doğrula
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Tedarik ajanı ---
AGENT_CHECK_INTERVAL_MIN=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
NOTIFY_DRY_RUN=true            # true: mesaj gönderilmez, loglanır (geliştirme); demoda false
BUSINESS_NAME=OtoHesap Demo Mağaza
AGENT_SCHEDULER_ENABLED=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
