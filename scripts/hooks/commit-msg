#!/bin/sh
# OtoHesap commit-msg hook: yapay zeka imzalarını ve ortak-yazar satırlarını reddeder.
# Kurulum (bir kez, depo kökünde):  git config core.hooksPath scripts/hooks
msg_file="$1"
if grep -Eiq '^(co-authored-by|signed-off-by: .*(claude|codex|copilot|cursor|chatgpt|gemini))|generated with|generated by (claude|codex|copilot|cursor|chatgpt|gemini)|🤖' "$msg_file"; then
  echo "✗ Commit mesajında yapay zeka imzası / Co-Authored-By satırı var. Kaldırıp tekrar dene." >&2
  echo "  (AGENTS.md §8: katkılar yalnız ekip üyeleri adına görünür.)" >&2
  exit 1
fi
exit 0
